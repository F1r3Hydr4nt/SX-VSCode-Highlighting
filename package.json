{
  "name": "sx",
  "displayName": "SX",
  "description": "Bitcoin Script Extended Syntax Highlighting",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:sx"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sx",
        "aliases": ["SX", "sx"],
        "extensions": [".sx"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sx",
        "scopeName": "source.sx",
        "path": "./syntaxes/sx.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "SX Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/sx-theme.json"
      }
    ],
    "commands": [
      {
        "command": "sx.formatDocument",
        "title": "SX: Format Document",
        "category": "SX"
      },
      {
        "command": "sx.modifyStackIndices",
        "title": "SX: Modify Stack Indices...",
        "category": "SX"
      },
      {
        "command": "sx.stackIdxsBumpUp",
        "title": "SX: Stack Indices ++",
        "category": "SX"
      },
      {
        "command": "sx.stackIdxsBumpDown",
        "title": "SX: Stack Indices --",
        "category": "SX"
      }
    ],
    "keybindings": [
      {
        "command": "sx.formatDocument",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus && editorLangId == sx"
      },
      {
        "command": "sx.stackIdxsBumpUp",
        "key": "ctrl+shift+up",
        "mac": "cmd+shift+up",
        "when": "editorTextFocus && editorLangId == sx"
      },
      {
        "command": "sx.stackIdxsBumpDown",
        "key": "ctrl+shift+down",
        "mac": "cmd+shift+down",
        "when": "editorTextFocus && editorLangId == sx"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "yarn run lint",
    "test": "node ./test/run.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  }
}
